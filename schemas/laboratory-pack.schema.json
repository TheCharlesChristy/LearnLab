{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnlab.local/laboratory-pack",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "stateVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "level": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        }
      },
      "required": ["id", "title"]
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "minItems": 0,
            "maxItems": 16
          }
        },
        "required": ["id", "title", "criterion", "prerequisites"]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          }
        },
        "required": ["id", "title", "url", "note"]
      },
      "minItems": 1,
      "maxItems": 64
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9/._-]*$",
            "maxLength": 256
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          }
        },
        "required": ["path", "attribution"]
      },
      "minItems": 0,
      "maxItems": 64
    },
    "scopeNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    }
  },
  "required": [
    "formatVersion",
    "version",
    "stateVersion",
    "id",
    "title",
    "description",
    "audience",
    "level",
    "subject",
    "capabilities",
    "skills",
    "episodes",
    "references",
    "assets",
    "scopeNote"
  ],
  "$defs": {
    "element": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "resistor"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "ohms": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": ["type", "id", "ohms"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "switch"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "closed": {
              "type": "boolean"
            }
          },
          "required": ["type", "id", "closed"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["series", "parallel"]
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/element"
              },
              "minItems": 1,
              "maxItems": 8
            }
          },
          "required": ["type", "elements"]
        }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "choice"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2400
              },
              "correct": {
                "type": "boolean"
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2400
              }
            },
            "required": ["id", "text", "correct", "feedback"]
          },
          "minItems": 2,
          "maxItems": 6
        }
      },
      "required": ["type", "options"]
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "circuit"
        },
        "initial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "voltage": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "circuit": {
              "$ref": "#/$defs/element"
            }
          },
          "required": ["voltage", "circuit"]
        },
        "solution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "voltage": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "circuit": {
              "$ref": "#/$defs/element"
            }
          },
          "required": ["voltage", "circuit"]
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "values": {
                "type": "array",
                "items": {
                  "type": ["number", "boolean"]
                },
                "minItems": 2,
                "maxItems": 8
              }
            },
            "required": ["id", "values"]
          },
          "minItems": 1,
          "maxItems": 8
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reading": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "quantity": {
                "enum": ["current", "voltage", "power"]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": ["reading", "quantity", "min", "max"]
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": ["type", "initial", "solution", "labels", "controls", "goals"]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        },
        "role": {
          "enum": ["prediction", "practice", "transfer", "reflection"]
        },
        "activity": {
          "oneOf": [
            {
              "$ref": "#/$defs/choice"
            },
            {
              "$ref": "#/$defs/circuit"
            }
          ]
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          },
          "minItems": 1,
          "maxItems": 4
        },
        "workedExample": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passed": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "assisted": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["passed", "assisted"]
        },
        "bridge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        }
      },
      "required": [
        "id",
        "title",
        "prompt",
        "role",
        "activity",
        "hints",
        "workedExample",
        "mechanism",
        "transitions"
      ]
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2400
        },
        "estimatedMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 16
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 16
        },
        "start": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "debrief": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2400
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2400
            }
          },
          "required": ["title", "body"]
        }
      },
      "required": ["id", "title", "estimatedMinutes", "skills", "prerequisites", "start", "nodes"]
    }
  }
}
